# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example
road/

# 분링의 자치구 보상 색인 (실제 구 이름이 들어갑니다. 꼴은 recycle-data.example.json)
recycle-data/

# 계측용 임시 파일 (실물 자료가 들어갑니다)
scratch-*

# 얼굴 감지 가중치 (npm install 때 꾸러미에서 복사됩니다)
/public/models/

# 분리배출 보상 색인 (실제 구 이름이 들어갑니다. 꼴은 recycle-data.example.json)
/recycle-data/
