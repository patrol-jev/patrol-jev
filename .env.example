# 복사해서 .env.local 로 쓰세요. 이 파일에는 절대 실제 키를 적지 마세요.

# 1차 판단(Jev). https://console.typesafe.ai 에서 발급
TYPESAFE_API_KEY=

# 사진을 글로 옮기는 단계. 둘 중 하나면 됩니다. 둘 다 있으면 Claude 가 먼저 읽고(patrol.config.json 의 vision.first),
# 키 · 잔액 문제로 거절하면 OpenAI 꼴 서버가 이어 읽습니다.
# https://console.anthropic.com · https://platform.openai.com 에서 발급
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── 여기부터는 안 넣어도 됩니다 ─────────────────────────────

# 공개한 자리에서만. 하루에 이 장수까지 읽어 주고 넘으면 「받아서 쓰세요」로 안내합니다.
# PATROL_DEMO_PHOTOS_PER_DAY=10
# PATROL_DEMO_PASS=
